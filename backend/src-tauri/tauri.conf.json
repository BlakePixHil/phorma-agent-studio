{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phorma Agent Studio",
  "version": "0.1.0",
  "identifier": "com.phorma.agentstudio",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run start -- --port 7322",
    "devUrl": "http://localhost:7322",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "frontendDist": "../../frontend/dist/phorma/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Phorma Agent Studio",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
