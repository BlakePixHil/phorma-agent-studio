{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phorma Agent Studio",
  "version": "0.2.0-beta.9",
  "identifier": "com.phorma.agentstudio",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run start -- --port 7322",
    "devUrl": "http://localhost:7322",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "frontendDist": "../../frontend/dist/phorma/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Phorma Agent Studio",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../../engine/package.json": "deploy/engine/package.json",
      "../../engine/src/": "deploy/engine/src/",
      "../../cloud/package.json": "deploy/cloud/package.json",
      "../../cloud/package-lock.json": "deploy/cloud/package-lock.json",
      "../../cloud/tsconfig.json": "deploy/cloud/tsconfig.json",
      "../../cloud/wrangler.jsonc": "deploy/cloud/wrangler.jsonc",
      "../../cloud/src/": "deploy/cloud/src/",
      "../../cloud/migrations/": "deploy/cloud/migrations/",
      "../../cloud-aws/package.json": "deploy/cloud-aws/package.json",
      "../../cloud-aws/package-lock.json": "deploy/cloud-aws/package-lock.json",
      "../../cloud-aws/tsconfig.json": "deploy/cloud-aws/tsconfig.json",
      "../../cloud-aws/cdk.json": "deploy/cloud-aws/cdk.json",
      "../../cloud-aws/Dockerfile": "deploy/cloud-aws/Dockerfile",
      "../../cloud-aws/bin/": "deploy/cloud-aws/bin/",
      "../../cloud-aws/src/": "deploy/cloud-aws/src/"
    },
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2NTQ3MUFCQkFGRkIzQzkKUldUSnMvKzZxM0ZVbHJzdU5TVWdLUDZnMlBiT2ZNcXRIeDBrRHM4bVRBUmdScHZhelh4ZmFRR0QK",
      "endpoints": [
        "https://phorma-agent-studio-cloud.phorma-agent-studio.workers.dev/update/stable/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
