{
  "name": "@phorma/admin",
  "version": "0.2.0-beta.19",
  "private": true,
  "description": "Phorma Agent Studio telemetry admin dashboard - a standalone Angular app that reads the Clerk-authenticated /api/admin/telemetry/* routes on the cloud Worker.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "deploy": "wrangler deploy",
    "generate:world-map": "node scripts/generate-world-map.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/animations": "20.3.25",
    "@angular/cdk": "^20.0.3",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@primeuix/themes": "^2.0.3",
    "@tabler/icons-webfont": "^3.44.0",
    "chart.js": "^4.5.1",
    "ngx-clerk": "^0.2.0",
    "primeng": "^20.4.0",
    "rxjs": "~7.8.0",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.9",
    "@angular/cli": "^20.3.9",
    "@angular/compiler-cli": "^20.3.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/jasmine": "~5.1.0",
    "d3-geo": "^3.1.1",
    "fast-check": "4.9.0",
    "i18n-iso-countries": "^7.14.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "tailwindcss": "^4.3.1",
    "topojson-client": "^3.1.0",
    "typescript": "~5.9.2",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.0.0"
  }
}
