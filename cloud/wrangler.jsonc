// Phorma Agent Studio - cloud runtime configuration.
//
// This top-level config is DELIBERATELY GENERIC so it deploys cleanly into
// ANY Cloudflare account. It deliberately does NOT pin:
//   - `account_id` - wrangler resolves the account from your login. (Pinning
//     Phorma's own account id here made every BYO deploy fail.)
//   - an R2 bucket - the `RELEASES` binding is a Phorma-internal updater
//     feature and now lives under `env.hosted` only. `releases.ts` already
//     returns 503 when the binding is absent, so a BYO worker simply has no
//     release routes, which is correct.
//
// Deploys to YOUR Cloudflare account:
//   1. npx wrangler login
//   2. Set provider secrets (once):  npx wrangler secret put ANTHROPIC_API_KEY
//      (repeat for OPENAI_API_KEY / GEMINI_API_KEY / OPENROUTER_API_KEY as needed)
//   3. Protect the endpoints (recommended):  npx wrangler secret put PHORMA_TOKEN
//      To use Clerk user auth instead, set:  npx wrangler secret put CLERK_SECRET_KEY
//      (the studio then authenticates with Clerk session JWTs; PHORMA_TOKEN
//      remains as a fallback for non-Clerk clients)
//   4. npx wrangler deploy   (or use Deploy in the studio's Cloud dialog)
//
// Credentials a DEPLOYED workflow needs never travel with a push - the studio's
// keychain stays on the machine. Two ways to give the worker its own copy:
//
//   a) From the studio (recommended, no terminal). One-time setup:
//        npx wrangler secret put KEY_ENC_SECRET   # base64 32 random bytes, e.g.
//        #   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
//        npx wrangler secret put PHORMA_TOKEN     # required: the vault refuses
//        #   to store credentials on an unprotected worker
//      Then use the cloud button beside a secret in the studio's Connections
//      editor. Values are AES-GCM encrypted and held in the SecretVault
//      Durable Object; the worker reads them when a run resolves a connection.
//
//   b) As real worker secrets (always available, takes priority over the vault):
//      - Remote MCP node bearer tokens:  npx wrangler secret put MCP_<AUTHKEY>
//        e.g. the "Email (remote)" preset's authKey RESEND_API_KEY becomes
//        MCP_RESEND_API_KEY. Local (stdio) MCP servers cannot run here at all.
//      - Connection secrets:  npx wrangler secret put CONN_<ID>_<KEY>
//        (the exact name is in the error the run reports when one is missing)
//
// If you have MORE THAN ONE Cloudflare account, or you want a custom worker
// name or a custom portal domain, set those in the studio under
// Settings → Cloud. It writes a `wrangler.byo.jsonc` override (gitignored, so
// `git pull` never conflicts) and deploys with `--config`. Never hand-edit
// THIS file: it is version-controlled and shared with Phorma's own deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phorma-agent-studio-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "WorkflowAgent",
        "class_name": "WorkflowAgent"
      },
      // Portal slug registry + rate limiter (one instance per worker).
      {
        "name": "PortalIndex",
        "class_name": "PortalIndex"
      },
      // Encrypted credential vault for deployed runs (one instance per owner).
      {
        "name": "SecretVault",
        "class_name": "SecretVault"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorkflowAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PortalIndex"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["SecretVault"]
    }
  ],
  "observability": {
    "enabled": true
  },
  // NOTE: no `r2_buckets` here on purpose. The `RELEASES` bucket serves
  // Phorma's installer downloads and update manifests, so it is bound under
  // `env.hosted` only. A BYO worker has no reason to own that bucket.
  // ── Phorma Labs hosted deployment (multi-tenant) ─────────────────────────
  // Deployed ONLY by Phorma:  npx wrangler deploy --env hosted
  // Additional secrets (set with `wrangler secret put <NAME> --env hosted`):
  //   CLERK_SECRET_KEY            - Clerk backend key (required; fail-closed)
  //   CLERK_JWT_KEY               - Clerk instance PEM for offline JWT verify
  //   KEY_ENC_SECRET              - base64 32-byte AES-GCM key for stored runtime keys
  //   OPENROUTER_PROVISIONING_KEY - mints per-tenant credit-limited runtime keys
  //   PHORMA_ADMIN_TOKEN          - guards /api/provision + /api/deactivate
  // One-time setup:
  //   npx wrangler d1 create phorma-cloud            (paste id below)
  //   npx wrangler kv namespace create TENANTS       (paste id below)
  //   npx wrangler d1 migrations apply phorma-cloud --env hosted
  "env": {
    "hosted": {
      "name": "phorma-agent-studio-cloud",
      // Pinned HERE rather than at the top level, so Phorma's own deploy stays
      // non-interactive while a BYO deploy resolves the account from its own
      // `wrangler login`.
      "account_id": "a088bd7c3fb962dfb28d003e8478dffe",
      "vars": {
        "PHORMA_MODE": "hosted",
        "ALLOWED_ORIGINS": "http://localhost:7322,tauri://localhost,https://tauri.localhost"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "WorkflowAgent",
            "class_name": "WorkflowAgent"
          },
          // Portal slug registry + rate limiter (one instance per worker).
          {
            "name": "PortalIndex",
            "class_name": "PortalIndex"
          },
          // Encrypted credential vault for deployed runs (one instance per tenant).
          {
            "name": "SecretVault",
            "class_name": "SecretVault"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["WorkflowAgent"]
        },
        {
          "tag": "v2",
          "new_sqlite_classes": ["PortalIndex"]
        },
        {
          "tag": "v3",
          "new_sqlite_classes": ["SecretVault"]
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "phorma-cloud",
          "database_id": "d3928de1-cd4c-46c0-ac88-2794a8810ac5"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "TENANTS",
          "id": "1c916badb33e48a192d3684a3b15bd26"
        }
      ],
      "observability": {
        "enabled": true
      },
      "r2_buckets": [
        {
          "binding": "RELEASES",
          "bucket_name": "phorma-releases"
        }
      ]
    }
  }
}
