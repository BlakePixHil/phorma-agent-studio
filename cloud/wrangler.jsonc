// Phorma Agent Studio - cloud runtime configuration.
//
// This top-level config is DELIBERATELY GENERIC so it deploys cleanly into
// ANY Cloudflare account. It deliberately does NOT pin:
//   - `account_id` - wrangler resolves the account from your login. (Pinning
//     Phorma's own account id here made every BYO deploy fail.)
//   - an R2 bucket - the `RELEASES` binding is a Phorma-internal updater
//     feature and now lives under `env.hosted` only. `releases.ts` already
//     returns 503 when the binding is absent, so a BYO worker simply has no
//     release routes, which is correct.
//
// Deploys to YOUR Cloudflare account:
//   1. npx wrangler login
//   2. Set provider secrets (once):  npx wrangler secret put ANTHROPIC_API_KEY
//      (repeat for OPENAI_API_KEY / GEMINI_API_KEY / OPENROUTER_API_KEY as needed)
//   3. Protect the endpoints (recommended):  npx wrangler secret put PHORMA_TOKEN
//      To use Clerk user auth instead, set:  npx wrangler secret put CLERK_SECRET_KEY
//      (the studio then authenticates with Clerk session JWTs; PHORMA_TOKEN
//      remains as a fallback for non-Clerk clients)
//      One worker holds ONE `CLERK_SECRET_KEY`, and a session token minted by
//      one Clerk instance fails verification against another and reads 401. So
//      it has to match the publishable key the client build ships: a DEPLOYED
//      worker takes the PRODUCTION (`sk_live_`) key that pairs with
//      `frontend/src/environments/clerk.prod.ts`, while a local `wrangler dev`
//      takes the DEVELOPMENT (`sk_test_`) key that pairs with `clerk.ts`. Never
//      the live key in a `.dev.vars` - Clerk rejects production keys on
//      localhost, and local Stripe sandbox testing must not need the live
//      instance.
//   4. npx wrangler deploy   (or use Deploy in the studio's Cloud dialog)
//
// Everything below is about the DEPLOYED worker. For a LOCAL `wrangler dev`,
// copy `.dev.vars.example` to `.dev.vars` - it lists the same names with
// placeholder values, plus which of them hosted mode actually needs.
//
// Credentials a DEPLOYED workflow needs never travel with a push - the studio's
// keychain stays on the machine. Two ways to give the worker its own copy:
//
//   a) From the studio (recommended, no terminal). One-time setup:
//        npx wrangler secret put KEY_ENC_SECRET   # base64 32 random bytes, e.g.
//        #   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
//        npx wrangler secret put PHORMA_TOKEN     # required: the vault refuses
//        #   to store credentials on an unprotected worker
//      Then use the cloud button beside a secret in the studio's Connections
//      editor. Values are AES-GCM encrypted and held in the SecretVault
//      Durable Object; the worker reads them when a run resolves a connection.
//
//   b) As real worker secrets (always available, takes priority over the vault):
//      - Remote MCP node bearer tokens:  npx wrangler secret put MCP_<AUTHKEY>
//        e.g. the "Email (remote)" preset's authKey RESEND_API_KEY becomes
//        MCP_RESEND_API_KEY. Local (stdio) MCP servers cannot run here at all.
//      - Connection secrets:  npx wrangler secret put CONN_<ID>_<KEY>
//        (the exact name is in the error the run reports when one is missing)
//
// If you have MORE THAN ONE Cloudflare account, or you want a custom worker
// name or a custom portal domain, set those in the studio under
// Settings → Cloud. It writes a `wrangler.byo.jsonc` override (gitignored, so
// `git pull` never conflicts) and deploys with `--config`. Never hand-edit
// THIS file: it is version-controlled and shared with Phorma's own deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phorma-agent-studio-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "WorkflowAgent",
        "class_name": "WorkflowAgent"
      },
      // Portal slug registry + rate limiter (one instance per worker).
      {
        "name": "PortalIndex",
        "class_name": "PortalIndex"
      },
      // Encrypted credential vault for deployed runs (one instance per owner).
      {
        "name": "SecretVault",
        "class_name": "SecretVault"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorkflowAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PortalIndex"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["SecretVault"]
    }
  ],
  "observability": {
    "enabled": true
  },
  // NOTE: no `r2_buckets` here on purpose. The `RELEASES` bucket serves
  // Phorma's installer downloads and update manifests, so it is bound under
  // `env.hosted` only. A BYO worker has no reason to own that bucket.
  // ── Phorma Labs hosted deployment (multi-tenant) ─────────────────────────
  // Deployed ONLY by Phorma:  npx wrangler deploy --env hosted
  // Additional secrets (set with `wrangler secret put <NAME> --env hosted`):
  //   CLERK_SECRET_KEY            - Clerk backend key (required; fail-closed).
  //                                 PRODUCTION `sk_live_` here, since this is the
  //                                 worker production studio builds talk to. To
  //                                 verify a rotation use `/api/me` with a
  //                                 production session token: `/status.json`
  //                                 cannot, its Clerk probe returns 200 for any
  //                                 valid key regardless of instance.
  //   CLERK_JWT_KEY               - Clerk instance PEM for offline JWT verify.
  //                                 This is the instance's PUBLIC key, so it can
  //                                 always be regenerated rather than recovered:
  //                                 take `n`/`e` from
  //                                 https://clerk.<domain>/.well-known/jwts.json
  //                                 and export SPKI PEM. With a PEM set,
  //                                 @clerk/backend NEVER falls back to the secret
  //                                 key, so a STALE one 401s every production
  //                                 token with a failure that reads exactly like a
  //                                 wrong CLERK_SECRET_KEY.
  //   PHORMA_AUTH_SECRET          - base64 32 random bytes. HMAC key signing the
  //                                 desktop sign-in tokens issued by
  //                                 /api/auth/device/redeem. OPTIONAL: unset
  //                                 disables desktop sign-in entirely and leaves
  //                                 BYO behaviour byte-identical. Rotating it
  //                                 signs EVERY desktop install out at once, so
  //                                 set PHORMA_AUTH_SECRET_PREVIOUS for the
  //                                 overlap window and delete it afterwards.
  //   PHORMA_AUTH_SECRET_PREVIOUS - optional, verification only, rotation only.
  //   KEY_ENC_SECRET              - base64 32-byte AES-GCM key for stored runtime keys
  //   OPENROUTER_PROVISIONING_KEY - mints per-tenant credit-limited runtime keys.
  //                                 Account-level: ONE management key reaches every
  //                                 workspace, so a dedicated workspace needs the
  //                                 `var` below, not a second key.
  //   PHORMA_ADMIN_TOKEN          - guards /api/provision + /api/deactivate
  //   TELEMETRY_ADMIN_USER_IDS    - comma-separated Clerk user ids allowed to read
  //                                 /api/admin/telemetry/* (absent or empty = 403
  //                                 for everyone, which is the intended default)
  //   STRIPE_SECRET_KEY           - Stripe API secret (`sk_live_` on this worker,
  //                                 `sk_test_` for a sandbox). Authenticates every
  //                                 call the billing routes make.
  //   STRIPE_WEBHOOK_SECRET       - signing secret (`whsec_`) for the webhook
  //                                 endpoint, which is authenticated by SIGNATURE
  //                                 and has no bearer. Per ENDPOINT, not per
  //                                 account: `stripe listen --forward-to` prints a
  //                                 different value than a Dashboard endpoint, so
  //                                 a local run and this worker never share one.
  // Both Stripe secrets are OPTIONAL. A BYO worker binds neither and stays
  // healthy - an unconfigured billing route answers 501 naming the secret it
  // wants, so "billing is off here" never reads as "the worker is broken".
  // One-time setup:
  //   npx wrangler d1 create phorma-cloud            (paste id below)
  //   npx wrangler kv namespace create TENANTS       (paste id below)
  //   npx wrangler d1 migrations apply phorma-cloud --env hosted
  "env": {
    "hosted": {
      "name": "phorma-agent-studio-cloud",
      // Pinned HERE rather than at the top level, so Phorma's own deploy stays
      // non-interactive while a BYO deploy resolves the account from its own
      // `wrangler login`.
      "account_id": "a088bd7c3fb962dfb28d003e8478dffe",
      "vars": {
        "PHORMA_MODE": "hosted",
        // OpenRouter workspace every per-tenant runtime key is minted into
        // (requirement 36). A `var` and not a secret: a workspace UUID authorizes
        // nothing by itself, `OPENROUTER_PROVISIONING_KEY` is what does, and that
        // one management key reaches every workspace on the account.
        //
        // DELIBERATELY UNSET while the dedicated workspace does not exist yet.
        // `POST /api/v1/keys` defaults to the account's DEFAULT workspace when the
        // body carries no `workspace_id`, which is where every key minted so far
        // lives, so absent means "carry on as before" rather than a broken mint.
        //
        // Setting it is only HALF the move: keys already minted stay where they
        // are, because a key's workspace is fixed at creation and no PATCH moves
        // it. Set this var, deploy, then run
        // `npx tsx scripts/migrate-openrouter-workspace.mjs --apply` to re-mint
        // the existing tenants and retire their old keys.
        "OPENROUTER_WORKSPACE_ID": "4636ceab-0c37-4243-b504-5ad8b7a899eb",
        // The studio origins, plus the telemetry admin dashboard (the
        // `phorma-admin` worker). The dashboard belongs HERE because it is a
        // browser app on a real origin calling the authenticated
        // `/api/admin/telemetry/*` routes, so it has to pass the same CORS
        // check as the studio. The telemetry INGEST route (`/telemetry`) is the
        // opposite case: it answers its own preflight with an open CORS set and
        // never consults this list, precisely so accepting anonymous rollups
        // from anywhere does not widen the authenticated `/api/*` surface. A
        // custom dashboard domain would need adding here too.
        //
        // `http://localhost:7323` is the dashboard's dev server, the counterpart
        // of `http://localhost:7322` for the studio. Without it a local
        // `npm start` in `admin/` gets `Access-Control-Allow-Origin:
        // http://localhost:7322` (the list head is the fallback for an
        // unlisted origin) and every request fails the browser CORS check
        // before the authorization gate ever runs.
        //
        // The three `tauri*` entries are ONE client - the desktop build - whose
        // webview origin is platform dependent. Tauri v2 serves
        // `tauri://localhost` on macOS and Linux, and
        // `http://tauri.localhost` on Windows and Android unless
        // `app.windows.useHttpsScheme` is set, which
        // `backend/src-tauri/tauri.conf.json` does not set. The `https://`
        // form is kept because that flag (and Tauri v1) produce it: admitting a
        // scheme no build currently uses costs nothing, while omitting the one
        // it does use locks out every install on that platform.
        // `https://cloud.phorma-labs.com` is this worker's OWN origin. It is here
        // because `GET /auth/device` runs clerk-js on it and that page POSTs to
        // `/api/auth/device/claim`. Same-origin, so the browser needs no CORS for
        // it - but the two lists are kept in step deliberately (see
        // `CLERK_AUTHORIZED_PARTIES` below, where the same entry is NOT optional).
        "ALLOWED_ORIGINS": "http://localhost:7322,http://localhost:7323,tauri://localhost,http://tauri.localhost,https://tauri.localhost,https://phorma-admin.phorma-agent-studio.workers.dev,https://cloud.phorma-labs.com",
        // BETA ONLY: the Admin_API's k-anonymity floor (9.15) folds any group
        // under 5 distinct installs into `other`, which is nearly everything
        // at beta volume. Flip to "false" (or remove this line) once out of
        // beta to fold again - no other code or config changes needed.
        "TELEMETRY_K_ANONYMITY_DISABLED": "true",
        // Origins accepted as the Clerk JWT `azp` claim, which is the Origin the
        // token was minted from. It is replay/CSRF protection layered on top of
        // signature verification, NOT a substitute for `ALLOWED_ORIGINS`: CORS
        // gates the browser, this gates the token.
        //
        // `@clerk/backend` compares `azp` by exact string and skips the check
        // entirely when this var is unset (or when a token carries no `azp`), so
        // the failure mode of an incomplete list is a hard 401 on every request
        // from the missing origin rather than a degraded one. It therefore has
        // to name every origin that runs Clerk.js against this worker, which is
        // the same set as `ALLOWED_ORIGINS` above: both dev servers, the desktop
        // build's three possible webview origins, and the deployed dashboard.
        // Keep the two lists in step - an origin authorized here but rejected by
        // CORS, or the reverse, is a bug either way.
        //
        // A `var` rather than a secret: it is a list of public origins and it
        // belongs in version control beside the CORS list it mirrors. If a
        // `CLERK_AUTHORIZED_PARTIES` secret was ever set on this worker, delete
        // it (`npx wrangler secret delete ... --env hosted`) so one binding owns
        // the name. A local `wrangler dev` overrides it from `.dev.vars`.
        // `https://cloud.phorma-labs.com` is REQUIRED here, not tidiness. The
        // desktop sign-in page runs clerk-js on this worker's own origin, so the
        // session token it mints carries `azp: https://cloud.phorma-labs.com`.
        // `@clerk/backend` matches `azp` by exact string, so omitting this makes
        // `POST /api/auth/device/claim` a hard 401 and desktop sign-in silently
        // impossible - with nothing in the response to say why.
        "CLERK_AUTHORIZED_PARTIES": "http://localhost:7322,http://localhost:7323,tauri://localhost,http://tauri.localhost,https://tauri.localhost,https://phorma-admin.phorma-agent-studio.workers.dev,https://cloud.phorma-labs.com",

        // Clerk PUBLISHABLE key for the instance this worker verifies against -
        // a PUBLIC value, which is why it is a `var` and not a secret. It must
        // pair with `CLERK_SECRET_KEY`: `GET /auth/device` signs the user in to
        // whichever instance this names, and `verifyBearer` verifies against
        // whichever instance the secret names. A mismatch is a 401 on claim.
        // `pk_live_` here, matching `frontend/src/environments/clerk.prod.ts`.
        "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsucGhvcm1hLWxhYnMuY29tJA"
      },
      // Telemetry retention pass, daily at 03:17 UTC (the odd minute keeps it
      // off the top-of-hour crowd). HOSTED ONLY on purpose: a BYO deployment has
      // no `DB` binding and nothing to prune, so it gets no cron at all.
      "triggers": {
        "crons": ["17 3 * * *"]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "WorkflowAgent",
            "class_name": "WorkflowAgent"
          },
          // Portal slug registry + rate limiter (one instance per worker).
          {
            "name": "PortalIndex",
            "class_name": "PortalIndex"
          },
          // Encrypted credential vault for deployed runs (one instance per tenant).
          {
            "name": "SecretVault",
            "class_name": "SecretVault"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["WorkflowAgent"]
        },
        {
          "tag": "v2",
          "new_sqlite_classes": ["PortalIndex"]
        },
        {
          "tag": "v3",
          "new_sqlite_classes": ["SecretVault"]
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "phorma-cloud",
          "database_id": "d3928de1-cd4c-46c0-ac88-2794a8810ac5"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "TENANTS",
          "id": "1c916badb33e48a192d3684a3b15bd26"
        }
      ],
      "observability": {
        "enabled": true
      },
      "r2_buckets": [
        {
          "binding": "RELEASES",
          "bucket_name": "phorma-releases"
        }
      ]
    }
  }
}
