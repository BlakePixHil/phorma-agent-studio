/**
 * Regenerate `cloud-aws/test/fixtures/sentinel-corpus.json` from the canonical
 * Sentinel_Envelope encoder.
 *
 * Run this ONLY when the codec changed on purpose:
 *
 *     cd cloud-aws; node_modules/.bin/tsx scripts/gen-sentinel-corpus.mts
 *
 * The corpus is the cross-package contract: the Studio decoder half
 * (`frontend/src/app/core/deploy/sentinel-envelope.ts`) reproduces every payload
 * in it. `src/core/sentinel.spec.ts` re-encodes every committed case through the
 * real encoder and fails when the two disagree, so the file cannot drift
 * silently - which also means a deliberate codec change means regenerating here
 * AND re-running the frontend agreement test.
 *
 * Requirements: 10.4, 10.5
 */

import { writeFileSync, mkdirSync } from 'node:fs';
import { dirname, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import {
  SENTINEL_CHUNK_BYTES,
  SENTINEL_PREFIX,
  encodeSentinelEnvelope,
  type SentinelPayload,
} from '../src/core/sentinel.ts';

interface CorpusCase {
  readonly name: string;
  readonly description: string;
  readonly payload: string;
  readonly lines: readonly string[];
}

/** A `SentinelPayload` object case: the wire payload is its `JSON.stringify`. */
function objectCase(name: string, description: string, payload: SentinelPayload): CorpusCase {
  return { name, description, payload: JSON.stringify(payload), lines: encodeSentinelEnvelope(payload) };
}

function stringCase(name: string, description: string, payload: string): CorpusCase {
  return { name, description, payload, lines: encodeSentinelEnvelope(payload) };
}

const cases: readonly CorpusCase[] = [
  stringCase(
    'empty',
    'The empty payload still emits exactly one line, so a zero-line stream stays distinguishable from an empty result.',
    '',
  ),
  stringCase(
    'ascii',
    'Plain ASCII with CRLF, LF and a body that itself looks like envelope framing.',
    'HTTP/1.1 200 OK\r\ncontent-type: application/json\r\n\r\n{"ok":true,"note":"__phorma__:0:bm90LWFuLWVudmVsb3Bl"}\n',
  ),
  stringCase(
    'astral-plane',
    'Astral-plane code points, a ZWJ family sequence, combining marks and the last legal code point U+10FFFF.',
    'status \u2705 \u{1F642} \u{1D11E} \u{10FFFF} \u{1F469}\u200D\u{1F469}\u200D\u{1F467}\u200D\u{1F466} cafe\u0301 \u2603 \u672B\u5C3E',
  ),
  objectCase('http-response', 'An `http-response` payload carrying a non-2xx status and its body.', {
    kind: 'http-response',
    status: 403,
    headers: { 'content-type': 'application/x-amz-json-1.1', 'x-amzn-requestid': 'a1b2c3' },
    body: '{"__type":"AccessDeniedException","message":"not authorized to perform sts:GetCallerIdentity"}',
  }),
  stringCase(
    'multi-chunk',
    `Payload one byte past ${SENTINEL_CHUNK_BYTES}, so the encoder emits two lines.`,
    'x'.repeat(SENTINEL_CHUNK_BYTES + 1),
  ),
  stringCase(
    'chunk-boundary-straddle',
    `A 4-byte code point occupies bytes ${SENTINEL_CHUNK_BYTES - 2}..${SENTINEL_CHUNK_BYTES + 1}, so a chunker that cuts blind at ${SENTINEL_CHUNK_BYTES} bytes splits it and corrupts the decode.`,
    'x'.repeat(SENTINEL_CHUNK_BYTES - 2) + '\u{1F642}' + '-tail-cafe\u0301-\u2603-\u{1F642}-\u672B\u5C3E\n',
  ),
];

const corpus = {
  $comment:
    'Generated by cloud-aws/scripts/gen-sentinel-corpus.mts - do not hand-edit. Regenerate with: cd cloud-aws; node_modules/.bin/tsx scripts/gen-sentinel-corpus.mts',
  prefix: SENTINEL_PREFIX,
  chunkBytes: SENTINEL_CHUNK_BYTES,
  cases,
};

const here = dirname(fileURLToPath(import.meta.url));
const target = resolve(here, '../test/fixtures/sentinel-corpus.json');
mkdirSync(dirname(target), { recursive: true });
writeFileSync(target, `${JSON.stringify(corpus, undefined, 2)}\n`, 'utf8');

const lineCount = cases.reduce((sum, entry) => sum + entry.lines.length, 0);
console.log(`wrote ${target}: ${cases.length} cases, ${lineCount} lines`);
