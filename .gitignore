
# Wrangler local cache
.wrangler/

# Dependencies + build output (all packages)
node_modules/
mcp/*/dist/
# `wrangler deploy --dry-run --outdir=…` output (cloud/ npm run check writes dist/)
cloud/dist*/
# Per-user wrangler override generated by Settings → Cloud. Keeps a BYO user's
# account id / worker name / portal domain out of the committed wrangler.jsonc.
cloud/wrangler.byo.jsonc

# CDK synthesis output (cloud-aws/)
cloud-aws/cdk.out/
# Schedule_Shim Lambda bundle, produced by cloud-aws/src/shim/build.ts before
# every synth. Build output, so it is rebuilt rather than committed.
cloud-aws/dist/
# CDK context cache. The IaC app uses Vpc.fromVpcAttributes and never
# fromLookup, so this file stays empty and carries nothing worth committing.
cloud-aws/cdk.context.json
# Per-user AWS deploy config generated by Settings -> Cloud. Keeps operator
# account id / region / permissions boundary out of the committed cdk.json.
cloud-aws/cdk.context.phorma.json
